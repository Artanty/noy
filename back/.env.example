# The render.com backend to wake (full URL, incl. path if the app needs one).
# GET /wake uses this when no ?target= query param is passed.
WAKE_TARGET=https://your-app.onrender.com/

# Server (bind 0.0.0.0 so the platform health-check can reach you)
HOST=0.0.0.0
PORT=3211

# Wake timings in ms (defaults ported from the node build):
# WAKE_TOTAL_WAIT_MS=185000   total budget (~3 min)
# WAKE_PROBE_PAUSE_MS=60000   silent pause between probes
# WAKE_CHECK_TIMEOUT_MS=10000 per-probe timeout
